var s2 = ee.ImageCollection('COPERNICUS/S2_SR')
          .filterDate('2017-09-01', '2017-12-15')
          .filterBounds(roi)
          .select('B8', 'B12')
          .median(); // Reduce the collection to a single image by taking the median;


//remove cloud pixels from the integrated image ====================== > not sure if it is useful
var maskClouds = function(image) {
  var qa = image.select('QA60');
  var mask = qa.bitwiseAnd(1 << 10).eq(0);
  return image.updateMask(mask);
};

// Apply the cloud mask
var s2masked = maskClouds(s2);

// Filter the image collection by date to get prefire image
var prefireImage = s2masked.filterDate('2017-09-01', '2017-09-30').median();

// Filter the image collection by date to get postfire image
var postfireImage = s2masked.filterDate('2017-10-01', '2017-12-15').median();

// Compute prefire NBR
var prefire_nbr = prefireImage.expression('(nir-swir)/(nir+swir)', {
  'nir': prefireImage.select('B8'),
  'swir': prefireImage.select('B12')
}).rename('prefire_NBR');

// Compute postfire NBR
var postfire_nbr = postfireImage.expression('(nir-swir)/(nir+swir)', {
  'nir': postfireImage.select('B8'),
  'swir': postfireImage.select('B12')
}).rename('postfire_NBR');