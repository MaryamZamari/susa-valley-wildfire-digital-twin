/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var geometry = 
    /* color: #ffffff */
    /* shown: false */
    ee.Geometry.Polygon(
        [[[7.003083958928165, 45.21869339705463],
          [7.003083958928165, 45.110246992050875],
          [7.219377293889102, 45.110246992050875],
          [7.219377293889102, 45.21869339705463]]], null, false),
    geometry2 = 
    /* color: #7aa93d */
    /* shown: false */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[7.011323522807711, 45.20994425310098],
          [7.011323522807711, 45.11601945581964],
          [7.214570593120211, 45.11601945581964],
          [7.214570593120211, 45.20994425310098]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/
geometry2 = 
    geometry2;
    
// importing pre-fire and post-fire NBR images (the same dates for which NBR was calculated).
var prefire_image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20170619T103021_20170619T103806_T32TLR')
                      .select('B8', 'B12');
                        
var postfire_image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20171116T103311_20171116T103542_T32TLR')
                       .select('B8', 'B12');

//----------------------NBR Calculations for Post and Prefire-------------------
// Expression using image band indices to calculate NBR
var bandIndexExp = '(b("B8") - b("B12")) / (b("B8") + b("B12"))';
var prefire_nbr =  prefire_image.expression(bandIndexExp).rename('NBR_Prefire');
var postfire_nbr = postfire_image.expression(bandIndexExp).rename('NBR_Postfire');

// delta_nbr calculation(Burn Severity formula)-----------------------------------
var delta_nbr = prefire_nbr.subtract(postfire_nbr).rename('dNBR');

// Clip the dNBR image to your geometry
var clipped_dNBR = delta_nbr.clip(geometry);

//thresholds lt
var threshold_enhanced_regrowth_high = -0.251;  
var threshold_enhanced_regrowth_low = -0.101 ; 
var threshold_unburned= 0.1;//0.99;
var threshold_low_severity= 0.27;
var threshold_moderate_low_severity= 0.44;
var threshold_moderate_high_severity= 0.66;
var threshold_high_severity= 1;//;


// defining the burn severity image based on the threshholds and values_3,2,1,0 are values for visualisation
var burnSeverity = clipped_dNBR.expression(
      "(b('dNBR') <= threshold_enhanced_regrowth_high) ? 0" + 
    ": (b('dNBR') <= threshold_enhanced_regrowth_low) ? 1" +  // Moderate-high burn severity
    ": (b('dNBR') <= threshold_unburned) ? 2" +  // Moderate-low burn severity
    ": (b('dNBR') <= threshold_low_severity) ? 3" + 
    ": (b('dNBR') <= threshold_moderate_low_severity ) ? 4" + 
    ": (b('dNBR') <= threshold_moderate_high_severity) ? 5" + 
    ": (b('dNBR') <= threshold_high_severity) ? 6" +
      ":7" 
  , {
     threshold_enhanced_regrowth_high : threshold_enhanced_regrowth_high ,  
     threshold_enhanced_regrowth_low : threshold_enhanced_regrowth_low , 
     threshold_unburned : threshold_unburned ,
     threshold_low_severity : threshold_low_severity ,
     threshold_moderate_low_severity : threshold_moderate_low_severity ,
     threshold_moderate_high_severity : threshold_moderate_high_severity ,
     threshold_high_severity : threshold_high_severity  ,
  }).rename(['burnSeverity']);

//masking image with different categories for area calculation
var highSeverity_6 = burnSeverity.where(burnSeverity.eq(6), 1).where(burnSeverity.neq(6), 0);
var moderateHighSeverity_5 = burnSeverity.where(burnSeverity.eq(5), 1).where(burnSeverity.neq(5), 0);
var moderate_low_severity_4 = burnSeverity.where(burnSeverity.eq(4), 1).where(burnSeverity.neq(4), 0);
var low_severity_3 = burnSeverity.where(burnSeverity.eq(3), 1).where(burnSeverity.neq(3), 0);
/*var unburned_2 = burnSeverity.where(burnSeverity.eq(2), 1).where(burnSeverity.neq(2), 0);
var enhanced_regrowth_low_1 = burnSeverity.where(burnSeverity.eq(1), 1).where(burnSeverity.neq(1), 0);
var enhanced_regrowth_high_0 = burnSeverity.where(burnSeverity.eq(0), 1).where(burnSeverity.neq(0), 0); */

var dnbr_6= clipped_dNBR.updateMask(burnSeverity.eq(6));
var dnbr_5= clipped_dNBR.updateMask(burnSeverity.eq(5));
var dnbr_4= clipped_dNBR.updateMask(burnSeverity.eq(4));
var dnbr_3= clipped_dNBR.updateMask(burnSeverity.eq(3));
/*var dnbr_2= clipped_dNBR.updateMask(burnSeverity.eq(2));
var dnbr_1= clipped_dNBR.updateMask(burnSeverity.eq(1));
var dnbr_0= clipped_dNBR.updateMask(burnSeverity.eq(0)); */

//----------Area ----------------
//-------Merging the masked images (merging the two bands in 1 band)--


/*var burnedNBRImageMerged = burnedNBRImage
                                .select(['B8', 'B12'])
                                .reduce(ee.Reducer.sum())
                                .toFloat()
                                .rename('burnedNBRImageMerged');
    */                            
//------Mergine the complete image into 1 band
var imageMerged= clipped_dNBR
                    .reduce(ee.Reducer.sum())
                    .toFloat()
                    .rename('imageMerged');
  
//**************** Solution From StackoverFlow ************
var totalAreaImage = ee.Image.pixelArea()
  .updateMask(imageMerged.mask())
  .rename('totalArea');
 
//----6------ 
var highSeverityAreaImage = totalAreaImage
  .updateMask(dnbr_6)
  .rename('high_severityArea');
  
var areas6 = totalAreaImage
  .addBands(highSeverityAreaImage)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: geometry2,
    scale: 10,
    crs: 'EPSG:32632',
    maxPixels: 1e13
  });
  
//----5------ 
var moderateHighSeverityAreaImg = totalAreaImage
  .updateMask(dnbr_5)
  .rename('moderateHighSeverityArea');
  
var areas5 = totalAreaImage
  .addBands(moderateHighSeverityAreaImg)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: geometry2,
    scale: 10,
    crs: 'EPSG:32632',
    maxPixels: 1e13
  });

//----4------ 
var moderateLowSeverityAreaImage = totalAreaImage
  .updateMask(dnbr_4)
  .rename('moderateLowSeverityArea');
  
var areas4 = totalAreaImage
  .addBands(moderateLowSeverityAreaImage)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: geometry2,
    scale: 10,
    crs: 'EPSG:32632',
    maxPixels: 1e13
  });

//----3------ 
var lowSeverityAreaImage = totalAreaImage
  .updateMask(dnbr_3)
  .rename('lowSeverityArea');
  
var areas3 = totalAreaImage
  .addBands(lowSeverityAreaImage)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: geometry2,
    scale: 10,
    crs: 'EPSG:32632',
    maxPixels: 1e13
  });
  
///----6------------------  
var high_severityArea = areas6.getNumber('high_severityArea');
var totalArea = areas6.getNumber('totalArea');
var percentage_6 = high_severityArea.divide(totalArea).multiply(100);

///----5------------------  
var moderateHighSeverityArea = areas5.getNumber('moderateHighSeverityArea');
var percentage_5 = moderateHighSeverityArea.divide(totalArea).multiply(100);

///----4------------------  
var moderateLowSeverityArea = areas4.getNumber('moderateLowSeverityArea');
var percentage_4 = moderateLowSeverityArea.divide(totalArea).multiply(100);

///----3------------------  
var lowSeverityArea = areas3.getNumber('lowSeverityArea');
var percentage_3 = lowSeverityArea.divide(totalArea).multiply(100);

//------6---------------------
print('high_severityArea (Hectares)', high_severityArea.divide(10000));
print('high_severityArea Fraction (%)', percentage_6);

//------5---------------------
print('moderateHighSeverityArea (Hectares)', moderateHighSeverityArea.divide(10000));
print('Total Area (Hectares)', totalArea.divide(10000));
print('moderateHighSeverityArea Fraction (%)', percentage_5);

//------4---------------------
print('moderateLowSeverityArea (Hectares)', moderateLowSeverityArea.divide(10000));
print('Total Area (Hectares)', totalArea.divide(10000));
print('moderateLowSeverityArea Fraction (%)', percentage_4);

//------3---------------------
print('lowSeverityArea (Hectares)', lowSeverityArea.divide(10000));
print('Total Area (Hectares)', totalArea.divide(10000));
print('lowSeverityArea Fraction (%)', percentage_3);





