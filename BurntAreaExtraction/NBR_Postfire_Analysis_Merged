// =========================================================================
// 1. IMPORTS & GEOMETRY DEFINITION
// =========================================================================
var affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");
var geoCEMS = ee.Geometry.Polygon(
  [[[7.029021402162807, 45.21972611576043],
    [7.029021402162807, 45.1146736921262],
    [7.2092658479635885, 45.1146736921262],
    [7.2092658479635885, 45.21972611576043]]], null, false);

var resultGeometry = geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3));

// =========================================================================
// 2. IMAGE PREPROCESSING & POST-FIRE NBR COMPUTATION
// =========================================================================
var waterMask = ee.Image('JRC/GSW1_2/GlobalSurfaceWater').select('max_extent').not();

var postFireImage = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20171116T103311_20171116T103542_T32TLR')
  .select(['B12', 'B8'])
  .updateMask(waterMask);

var nbrPostFire = postFireImage.normalizedDifference(['B8', 'B12']).rename('NBR_Post');

// =========================================================================
// 3. SINGLE-SCENE POST-FIRE CLASSIFICATION
// =========================================================================
var thresh_SevereBurn = -0.9; 
var thresh_ModeratetoSevereBurn = -0.8;
var thresh_ModerateBurn = -0.7;
var thresh_moderateLowBurn = -0.6; 
var thresh_LowBurn = -0.5;
var thresh_VeryLowBurn = -0.4; 
var thresh_NoBurnOrVeryLowSeverityBurn = -0.1; 
var thresh_NoBurnOrLowSeverityBurn = 0; 

var nbrClassified = nbrPostFire.expression(
  "(b('NBR_Post') < thresh_SevereBurn) ? 0" +   
  ": (b('NBR_Post') <= thresh_ModeratetoSevereBurn) ? 1" +  
  ": (b('NBR_Post') <= thresh_ModerateBurn) ? 2" +  
  ": (b('NBR_Post') <= thresh_moderateLowBurn) ? 3" + 
  ": (b('NBR_Post') <= thresh_LowBurn) ? 4" +
  ": (b('NBR_Post') <= thresh_VeryLowBurn) ? 5" +
  ": (b('NBR_Post') <= thresh_NoBurnOrVeryLowSeverityBurn) ? 6" +
  ": (b('NBR_Post') <= thresh_NoBurnOrLowSeverityBurn) ? 7" +
  ": 8", 
  {
    thresh_SevereBurn: thresh_SevereBurn,
    thresh_ModeratetoSevereBurn: thresh_ModeratetoSevereBurn,
    thresh_ModerateBurn: thresh_ModerateBurn,
    thresh_moderateLowBurn: thresh_moderateLowBurn,
    thresh_LowBurn: thresh_LowBurn,
    thresh_VeryLowBurn: thresh_VeryLowBurn,
    thresh_NoBurnOrVeryLowSeverityBurn: thresh_NoBurnOrVeryLowSeverityBurn,
    thresh_NoBurnOrLowSeverityBurn: thresh_NoBurnOrLowSeverityBurn
  }
).rename('NBR_ClassifiedSeverity');

// =========================================================================
// 4. STATISTICAL AREA CALCULATIONS
// =========================================================================
var threshBurned = -0.1;
var burnedMask = nbrPostFire.lt(threshBurned);

var areaImage = ee.Image.pixelArea().rename('totalArea')
  .addBands(ee.Image.pixelArea().updateMask(burnedMask).rename('burnedArea'));

var areaStats = areaImage.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: geoCEMS,
  scale: 10,
  crs: 'EPSG:32632',
  maxPixels: 1e13
});

var burnedAreaHa = ee.Number(areaStats.get('burnedArea')).divide(10000);
var totalAreaHa = ee.Number(areaStats.get('totalArea')).divide(10000);
var burnedPercentage = burnedAreaHa.divide(totalAreaHa).multiply(100);

print('=== POST-FIRE SINGLE-SCENE METRICS ===');
print('Burned Area (Hectares):', burnedAreaHa);
print('Total Area (Hectares):', totalAreaHa);
print('Burned Fraction (%):', burnedPercentage);

// =========================================================================
// 5. MAP VISUALIZATION & LEGEND
// =========================================================================
Map.centerObject(affectedAreaCEMS, 12);

var nbrPalette = ['#8B0000', '#FF0000', '#FF4500', '#FFA500', '#FFD700', '#FFFF00', '#90EE90', '#008000', '#FFFFFF'];

Map.addLayer(nbrPostFire, {min: -1, max: 1, palette: ['red', 'orange', 'green']}, 'Post-Fire NBR (Continuous)', false);
Map.addLayer(nbrClassified, {min: 0, max: 8, palette: nbrPalette}, 'Post-Fire NBR Classification');
Map.addLayer(resultGeometry, {color: 'black'}, 'Outer Geometry Boundary');

// Legend Builder
var legendPanel = ui.Panel({
  style: { position: 'bottom-left', padding: '8px' }
});
legendPanel.add(ui.Label({
  value: 'Post-Fire NBR Classes',
  style: { fontSize: '14px', fontWeight: 'bold', margin: '0 0 6px 0' }
}));

var nbrClasses = [
  'Severe burn', 'Moderate to severe burn', 'Moderate burn', 
  'Moderate to low burn', 'Low burn', 'Very low burn', 
  'No burn / Very low', 'No burn / Low', 'Unclassified / Unburned'
];

for (var i = 0; i < nbrPalette.length; i++) {
  var colorBox = ui.Label({
    style: { backgroundColor: nbrPalette[i], padding: '8px', margin: '0 6px 4px 0' }
  });
  var description = ui.Label({
    value: nbrClasses[i],
    style: { margin: '2px 0 0 0', fontSize: '12px' }
  });
  legendPanel.add(ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  }));
}

Map.add(legendPanel);