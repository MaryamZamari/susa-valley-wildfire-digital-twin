// =========================================================================
// 1. IMPORTS & GEOMETRY DEFINITION
// =========================================================================
var affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");
var geoCEMS = ee.Geometry.Polygon(
  [[[7.029021402162807, 45.21972611576043],
    [7.029021402162807, 45.1146736921262],
    [7.2092658479635885, 45.1146736921262],
    [7.2092658479635885, 45.21972611576043]]], null, false);

var resultGeometry = geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3));

// =========================================================================
// 2. IMAGE PREPROCESSING & ORIGINAL NBR FORMULA
// =========================================================================
var waterMask = ee.Image('JRC/GSW1_2/GlobalSurfaceWater').select('max_extent').not();

var postFireImage = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20171116T103311_20171116T103542_T32TLR')
  .select(['B12', 'B8'])
  .updateMask(waterMask);

// Note: B12 first yields (B12 - B8) / (B12 + B8), matching original visualization
var nbrPostFire = postFireImage.normalizedDifference(['B12', 'B8']).rename('NBR');

// =========================================================================
// 3. 3-CLASS SIMPLE CLASSIFICATION (Matching Screenshot 2)
// =========================================================================
// Classified into: 0 = Burned (Red), 1 = Not Burned (Orange), 2 = Healthy Vegetation (Green)
var nbrSimpleClassified = nbrPostFire.expression(
  "(b('NBR') > 0.1) ? 0" +        // Burned
  ": (b('NBR') >= -0.2) ? 1" +    // Not burned / Bare soil
  ": 2",                          // Healthy vegetation
  { NBR: nbrPostFire }
).rename('NBR_Simple_Class');

// =========================================================================
// 4. MAP VISUALIZATION & ORIGINAL LEGEND
// =========================================================================
Map.centerObject(affectedAreaCEMS, 12);

// Add Continuous NBR Layer
Map.addLayer(
  nbrPostFire, 
  {min: -0.8, max: 0.8, palette: ['green', 'yellow', 'orange', 'red']}, 
  'Post-Fire NBR (Continuous)'
);

// Add 3-Class Layer (Screenshot 2 Style)
Map.addLayer(
  nbrSimpleClassified, 
  {min: 0, max: 2, palette: ['#FF0000', '#FFA500', '#008000']}, 
  'Classification (3 Classes)'
);

Map.addLayer(affectedAreaCEMS, {color: 'black'}, 'CEMS Event Boundary');

// Original 3-Class Legend Builder
var legendPanel = ui.Panel({
  style: { position: 'bottom-left', padding: '8px' }
});

legendPanel.add(ui.Label({
  value: 'Classification',
  style: { fontSize: '14px', fontWeight: 'bold', margin: '0 0 6px 0' }
}));

var classes = ['Burned', 'Not burned', 'Healthy vegetation'];
var colors = ['#FF0000', '#FFA500', '#008000'];

for (var i = 0; i < classes.length; i++) {
  var colorBox = ui.Label({
    style: { backgroundColor: colors[i], padding: '8px', margin: '0 6px 4px 0' }
  });
  var description = ui.Label({
    value: classes[i],
    style: { margin: '2px 0 0 0', fontSize: '12px' }
  });
  legendPanel.add(ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  }));
}

Map.add(legendPanel);