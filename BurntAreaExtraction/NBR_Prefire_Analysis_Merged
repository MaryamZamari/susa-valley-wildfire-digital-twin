// =========================================================================
// 1. IMPORTS & GEOMETRY DEFINITION
// =========================================================================
var geoCEMS = /* color: #d63000 */ee.Geometry.Polygon(
        [[[7.029021402162807, 45.21972611576043],
          [7.029021402162807, 45.1146736921262],
          [7.2092658479635885, 45.1146736921262],
          [7.2092658479635885, 45.21972611576043]]], null, false),
    affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");


// Extract outer boundary (geoCEMS minus CEMS burn event polygon)
var resultGeometry = geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3));

// =========================================================================
// 2. IMAGE PROCESSING & NBR COMPUTATION
// =========================================================================
// Load pre-fire Sentinel-2 Surface Reflectance scene
var preFireImage = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20170619T103021_20170619T103806_T32TLR')
  .select(['B12', 'B8', 'B4', 'B3', 'B2']);

// Calculate Normalized Burn Ratio (NBR) = (B8 - B12) / (B8 + B12)
var nbrPreFire = preFireImage.expression(
  '(b("B8") - b("B12")) / (b("B8") + b("B12"))'
).rename('NBR');

// =========================================================================
// 3. STATISTICAL HISTOGRAM
// =========================================================================
var histogramNBR = ui.Chart.image.histogram({
  image: nbrPreFire,
  region: affectedAreaCEMS,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
}).setOptions({
  title: 'Pre-Fire NBR Distribution (Susa Valley)',
  hAxis: { title: 'NBR' },
  vAxis: { title: 'Pixel Count' },
  colors: ['#1b9e77']
});

print(histogramNBR);

// =========================================================================
// 4. MAP VISUALIZATION & LAYERS
// =========================================================================
Map.centerObject(geoCEMS, 12);

// Standard continuous NBR Visualization
var nbrVis = { min: -1, max: 1, palette: ['red', 'orange', 'green'] };
Map.addLayer(nbrPreFire, nbrVis, 'Pre-Fire NBR (Continuous)');

// CEMS Reference Vector Overlay
Map.addLayer(resultGeometry, { color: 'black' }, 'Outside Burned Area Boundary');

// =========================================================================
// 5. DYNAMIC UI LEGEND FUNCTION
// =========================================================================
var buildLegend = function(titleText, colors, classes) {
  var legendPanel = ui.Panel({
    style: { position: 'bottom-left', padding: '8px' }
  });
  
  var legendTitle = ui.Label({
    value: titleText,
    style: { fontSize: '14px', fontWeight: 'bold', margin: '0 0 4px 0' }
  });
  legendPanel.add(legendTitle);

  for (var i = 0; i < colors.length; i++) {
    var colorBox = ui.Label({
      style: { backgroundColor: colors[i], padding: '8px', margin: '0 4px 4px 0' }
    });
    var description = ui.Label({
      value: classes[i],
      style: { margin: '2px 0 0 4px', fontSize: '12px' }
    });
    var row = ui.Panel({
      widgets: [colorBox, description],
      layout: ui.Panel.Layout.Flow('horizontal')
    });
    legendPanel.add(row);
  }
  return legendPanel;
};

// Add 3-class simplified legend to map
var legendColors = ['red', 'orange', 'green'];
var legendClasses = ['Burned / Low Index', 'Unburned / Moderate', 'Healthy Vegetation'];
Map.add(buildLegend('Pre-Fire NBR Status', legendColors, legendClasses));

// =========================================================================
// 6. EXPORT TASK
// =========================================================================
Export.image.toDrive({
  image: nbrPreFire,
  description: 'S2_20170619_NBR_Prefire',
  scale: 10,
  region: geoCEMS,
  maxPixels: 1e9
});