// Define the cloud mask function.
var maskClouds = function(image) {
  // Bitmask for cloudy pixels.
  var cloudyBitMask = 1 << 10;
  // Bitmask for shadow pixels.
  var shadowBitMask = 1 << 3;
  // Get the pixel QA band.
  var qa = image.select('QA60');
  // Both shadow and clouds are masked.
  var mask = qa.bitwiseAnd(cloudyBitMask).eq(0).and(qa.bitwiseAnd(shadowBitMask).eq(0));
  // Apply the mask to the image and return it.
  return image.updateMask(mask);
};

// Apply the cloud mask.
var maskedImage = maskClouds(image);


//End Test part-------------------------------------

