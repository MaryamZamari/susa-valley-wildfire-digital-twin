// Expression using image band indices to calculate NBR
var bandIndexExp = '(b("B8") - b("B12")) / (b("B8") + b("B12"))';
var bandIndexImg = image.expression(bandIndexExp).rename('NBR');

//---------------------TEST thresholds -----------------------------------
 var burnedAreas = -0.251;//: NBR < -0.251;
 var unburnedAreas = -0.101;//: NBR > -0.101;
 var healthyVegetation= 0.1; //: NBR > 0.1;
 
 
// defining the burn severity image based on the threshholds and values_3,2,1,0 are values for visualisation
var NBRimage = bandIndexImg.expression(
      "(b('NBR') <= burnedAreas) ? 0" + 
    ": (b('NBR') >= unburnedAreas) ? 1" +  // Moderate-high burn severity
    ": (b('NBR') >= healthyVegetation) ? 2" +  // Moderate-low burn severity
          ":3" 
  , {
     burnedAreas : burnedAreas ,  
     unburnedAreas : unburnedAreas , 
     healthyVegetation : healthyVegetation ,
    
  }).rename(['burnedAreasNBR']);
//---------------------Visualisation phase ----------------------------------------------
// Visualization parameters for NDVI.
var nbrVis = {min: -1, max: 1 , palette:['red','orange','green']};  
var nbrVis1 = {min: 0, max: 3, palette: ['red','orange','green', 'Grey']};

