 var image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20171116T103311_20171116T103542_T32TLR') //Post_Fire image
                        // .mosaic().clip(geometry) 
                         .select(['B12','B8'])
                          .updateMask(ee.Image('JRC/GSW1_2/GlobalSurfaceWater').select('max_extent').not()); // Mask out water areas; 

//---------------------------------------------------------
// Define the threshold values for each category
var burnedThreshold = -0.2;
var unburnedThreshold = 0.2;

// Expression using image band indices to calculate NBR
var bandIndexExp = '(b("B8") - b("B12")) / (b("B8") + b("B12"))';
var bandIndexImg = image.expression(bandIndexExp).rename('NBR');

//---------------------Visualisation phase ----------------------------------------------
// Visualization parameters for NDVI.
var nbrVis = {min: -1, max: 1 , palette:['red','orange','green']};  

//-------Area Calculation----------------------

var thresh_burned = -0.1; //lt
var thresh_unburned= 0.1; //lt
var thresh_healthyGreen= 0.1; //gt

//------------------------------QUANTIFICATION OF STATISTICS------------------
// Create binary masks for NBR pixel categories
var burnedMask = bandIndexImg.lt(thresh_burned);
var unburnedMask= bandIndexImg.lt(thresh_unburned);
var healthyMask= bandIndexImg.gt(thresh_healthyGreen);

// Mask the image based on the binary masks
var burnedNBRImage = image.updateMask(burnedMask);
var unburnedNBRImage = image.updateMask(unburnedMask);
var healthyNBRImage = image.updateMask(healthyMask);

//-------Merging the masked images (merging the two bands in 1 band)--
var burnedNBRImageMerged = burnedNBRImage
                                .select(['B8', 'B12'])
                                .reduce(ee.Reducer.sum())
                                .toFloat()
                                .rename('burnedNBRImageMerged');
  
//----Solution From StackoverFlow--------
var totalAreaImage = ee.Image.pixelArea()
  .updateMask(image.mask())
  .rename('totalArea')
var burnedAreaImage = totalAreaImage
  .updateMask(burnedNBRImageMerged)
  .rename('burnedArea')
var areas = totalAreaImage
  .addBands(burnedNBRImageMerged)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: BurnedRoi,
    scale: 10,
    crs: 'SR-ORG:6974',
    maxPixels: 1e13
  })
  
var desertArea = areas.getNumber('desertArea')
var totalArea = areas.getNumber('totalArea')
var percentage = desertArea.divide(totalArea).multiply(100)

print('Desert Area (million km²)', desertArea.divide(1e12))
print('Total Area (million km²)', totalArea.divide(1e12))
print('Desertified Fraction (%)', percentage)

//==========================================================================  
  
// Calculate the sum of pixels in the merged burned area
var burnedNbrPixels = burnedNBRImageMerged.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: BurnedRoi, //image.geometry(),
  scale: 10,
  maxPixels: 1e9   //to eliminate the error 
});

// Get the sum of burned area pixels   ---> same as burnedNbrPixels basically
var sumBurnedAreaPixels = burnedNbrPixels.get('burnedNBRImageMerged');

// Calculate the area covered by each pixel in hectares
var pixelArea = ee.Image.pixelArea().divide(100000);

// Calculate the burned area in hectares
var burnedAreaHa = burnedNBRImageMerged.multiply(pixelArea)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: BurnedRoi,
    scale: 10,
    maxPixels: 1e9
  })
  .get('burnedNBRImageMerged');
  
//total area calculation
//-------Merging the masked images (merging the two bands in 1 band)--
var imageMerged = image
                                .select(['B8', 'B12'])
                                .reduce(ee.Reducer.sum())
                                .toFloat()
                                .rename('imageMerged');
                                
// Calculate the sum of pixels in the image
var imagePixels = image.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: geometry, //image.geometry(),
  scale: 10,
  maxPixels: 1e9   //to eliminate the error 
});

// Calculate the image area in hectares
var imageTotalAreaHa = imageMerged.multiply(pixelArea)
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: geometry,
    scale: 10,
    maxPixels: 1e9
  })
  .get('imageMerged');

//######### Print the burned area in hectares##########################.
print('Burned area (ha):', burnedAreaHa);
print('Total area (ha):', imageTotalAreaHa);
print('BurnedNbrPixels:', burnedNbrPixels);

