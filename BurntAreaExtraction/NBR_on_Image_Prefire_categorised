 var image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20170619T103021_20170619T103806_T32TLR') //Post_Fire image
                        // .mosaic().clip(geometry) 
                         .select(['B12','B8']); 

//----------------------------------------------------------

// Expression using image band indices to calculate NBR
var bandIndexExp = '(b("B8") - b("B12")) / (b("B8") + b("B12"))';
var bandIndexImg = image.expression(bandIndexExp).rename('NBR');


//---------------------Visualisation phase ----------------------------------------------
// Visualization parameters for NDVI.
//var nbrVis = {min: -1, max: 1 , palette:['red','orange','green']};  
// Visualization parameters for NDVI.
var nbrVis = {min: 0, max: 8 , palette:['#8B0000','#FF0000','#FF4500', '#FFA500', '#FFD700', '#FFFF00', '#90EE90', '#008000']};  

//-------------------
//--------thresholds (lt)----------------------------
var thresh_SevereBurn = -0.9; 
var thresh_ModeratetoSevereBurn= -0.8;
var thresh_ModerateBurn= -0.7;
var thresh_moderateLowBurn= -0.6; 
var thresh_LowBurn= -0.5;
var thresh_VeryLowBurn= -0.4; 
var thresh_NoBurnOrVeryLowSeverityBurn= -0.1; 
var thresh_NoBurnOrLowSeverityBurn = 0; 
var thresh_NoBurn = 1;

// defining the NBR image based on the threshholds and values_3,2,1,0 are values for visualisation
var nbr_classified = bandIndexImg.expression(
  "(b('NBR') < thresh_SevereBurn) ? 0" +   
    ": (b('NBR') <= thresh_ModeratetoSevereBurn) ? 1" +  
    ": (b('NBR') <= thresh_ModerateBurn) ? 2" +  
    ": (b('NBR') <= thresh_moderateLowBurn) ? 3" + 
    ": (b('NBR') <= thresh_LowBurn) ? 4" +
    ": (b('NBR') <= thresh_VeryLowBurn) ? 5" +
    ": (b('NBR') <= thresh_NoBurnOrVeryLowSeverityBurn) ? 6" +
    ": (b('NBR') <= thresh_NoBurnOrLowSeverityBurn) ? 7" +
     ": (b('NBR') <= thresh_NoBurn) ? 8" +
      ":9" //unclassified 
  , {
     thresh_SevereBurn : thresh_SevereBurn ,
     thresh_ModeratetoSevereBurn : thresh_ModeratetoSevereBurn ,
     thresh_ModerateBurn : thresh_ModerateBurn ,
     thresh_moderateLowBurn : thresh_moderateLowBurn ,
     thresh_LowBurn : thresh_LowBurn,
     thresh_VeryLowBurn : thresh_VeryLowBurn,
     thresh_NoBurnOrVeryLowSeverityBurn : thresh_NoBurnOrVeryLowSeverityBurn,
     thresh_NoBurnOrLowSeverityBurn : thresh_NoBurnOrLowSeverityBurn,
     thresh_NoBurn: thresh_NoBurn,
    })
    .rename(['NBR_ClassifiedSeverity']);



print(image);
Map.centerObject(geometry);
//Map.addLayer(bandIndexImg , nbrVis, 'NBR1'); 
Map.addLayer(nbr_classified , nbrVis, 'NBR1');
Map.addLayer(geometry);

