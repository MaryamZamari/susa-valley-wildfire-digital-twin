//MultiSpectral Instrument, Level-2A Sentinel2 by Copernicus
// Loading the Sentinel-2 image collection for the time period of interest
 //because the number of bands for S2 overtime have been 
                    //inconsistent so to avoid error, we select the bands we need for analysis
 var sentinel2 = ee.ImageCollection('COPERNICUS/S2_SR')
                    .filterDate('2017-09-01', '2017-12-31') //time period
                    .filterBounds(roi)      //AOI
                    .select('B8','B12');    

print(sentinel2.size()); //number of sentinel 2 images for the ROI within the defined period

// Define the NBR function
var nbr = function(image)
    { 
      var nir = image.select('B8'); 
      var swir = image.select('B12');
      
      var nbr = nir.subtract(swir)
                .divide(nir.add(swir))
                .rename('NBR'); 
                
       return image.addBands(nbr);
   }; 

// Apply the NBR function to the Sentinel-2 image collection _ lt= less than _ 
var sentinel2Nbr = sentinel2.map(nbr); 

Map.addLayer(sentinel2Nbr);

