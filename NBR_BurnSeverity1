//MultiSpectral Instrument, Level-2A Sentinel2 by Copernicus
// Loading the Sentinel-2 image collection for the time period of interest
 //because the number of bands for S2 overtime have been 
                    //inconsistent so to avoid error, we select the bands we need for analysis
 
 // Define the time period of interest
var start = ee.Date('2017-09-01');
var end = ee.Date('2017-12-31');
var interval = 3; // in days
 
   // Load Sentinel-2 data
var s2 = ee.ImageCollection('COPERNICUS/S2_SR')
          .filterBounds(roi)
          .filterDate(start, end)
          .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
          .select(['B8', 'B11'])
          .map(function(img) {
            return img.divide(10000); // scale factor
          });

print(sentinel2.size()); //number of sentinel 2 images for the ROI within the defined period


// Function to calculate the NBR index
var calculateNBR = function(img) {
  return img.normalizedDifference(['B11', 'B8']).rename('NBR');
};

// Calculate NBR for each image in the collection
var nbr = s2.map(calculateNBR);

// Calculate the pre-fire and post-fire NBR images
var preFire = nbr.filterDate(start.advance(-1, 'year'), start);
var postFire = nbr.filterDate(start, end);

// Calculate the delta NBR image (post-fire minus pre-fire)
var deltaNBR = postFire.mean().subtract(preFire.mean()).rename('deltaNBR');

// Define the burn severity classification thresholds
var thres1 = -0.1;
var thres2 = 0.1;

// Create the burn severity map using the delta NBR image
var severity = deltaNBR.expression(
  '(deltaNBR > thres2) ? 2 : ' +
  '((deltaNBR > thres1) ? 1 : 0)',
  {
    'deltaNBR': deltaNBR,
    'thres1': thres1,
    'thres2': thres2
  }).rename('burnSeverity');

// Display the burn severity map
Map.addLayer(severity, {min: 0, max: 2, palette: ['green', 'yellow', 'red']}, 'Burn Severity');
