/* Define the Susa Valley region of interest 
/===> We did by importing the polygone based on the geographyc coordinates */

//MultiSpectral Instrument, Level-2A Sentinel2 by Copernicus
// Loading the Sentinel-2 image collection for the time period of interest
 //because the number of bands for S2 overtime have been 
                    //inconsistent so to avoid error, we select the bands we need for analysis
 
 // Define the time period of interest
var start = ee.Date('2017-09-01');
var end = ee.Date('2017-12-31');
var interval = 3; // in days
 
// Load Sentinel-2 data
var sentinel2 = ee.ImageCollection('COPERNICUS/S2_SR')
          .filterBounds(roi)
          .filterDate(start, end)
          .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
          .select(['B8', 'B12'])
          .map(function(img) {
            return img.divide(10000); // scale factor
          });

// Define the NBR function
var calcNBR = function(image) {
  var nbr = image.normalizedDifference(['B8', 'B12']).rename('NBR');
  return image.addBands(nbr);
};

// Map the NBR function over the collection
var s2_nbr = sentinel2.map(calcNBR);

// Define a mask image
//var mask = s2_nbr.select('NBR').gt(0.1);

// Calculate the pre-fire and post-fire mean NBR
var prefire_nbr = s2_nbr.filterDate('2017-09-01', '2017-09-30').select('NBR').mean();
var postfire_nbr = s2_nbr.filterDate('2017-10-01', '2017-12-31').select('NBR').mean();

// Calculate the NBR difference and mask it using the mask image
var nbr_diff = postfire_nbr.subtract(prefire_nbr);//.updateMask(mask);

// Define a color palette for visualizing the burn severity
var palette = ['white', 'brown', 'orange', 'red', 'darkred'];
var vis = {min: -1, max: 1, palette: palette};

// Display the burn severity map
Map.centerObject(roi , 11);
Map.addLayer(nbr_diff, vis, 'Burn Severity');

