/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var roi = 
    /* color: #80929d */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[6.5947420758131114, 45.20882936495508],
          [6.5947420758131114, 44.91394352253096],
          [7.716034190070924, 44.91394352253096],
          [7.716034190070924, 45.20882936495508]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/


// Load Sentinel-2 image collection
var s2 = ee.ImageCollection('COPERNICUS/S2_SR')
  .filterDate('2017-09-01', '2017-12-31')
  .filterBounds(roi)
  .sort('CLOUD_COVER', false);

// Function to calculate NBR index
var calculateNBR = function(image) {
  var nir = image.select('B8');
  var swir = image.select('B12');
  var nbr = nir.subtract(swir).divide(nir.add(swir)).rename('NBR');
  return image.addBands(nbr);
};

// Apply NBR index to image collection
var s2_nbr = s2.map(calculateNBR);

// Define pre-fire image
var preFireImage = s2_nbr.filterDate('2017-09-01', '2017-09-30').median();

// Define post-fire image
var postFireImage = s2_nbr.filterDate('2017-12-01', '2017-12-31').median();

// Calculate difference NBR image
var diffNBR = postFireImage.select('NBR').subtract(preFireImage.select('NBR')).rename('diffNBR');

// Define thresholds for burn severity classes
var thresholds = ee.Image([-0.1, 0, 0.1]);

// Reclassify difference NBR image into burn severity classes
var burnSeverity = diffNBR.gt(thresholds).add([1, 2]).rename('burnSeverity');

// Display burn severity map
Map.addLayer(burnSeverity, {min: 1, max: 2, palette: ['yellow', 'red']}, 'Burn Severity');