 var imageTOA = ee.Image('COPERNICUS/S2_HARMONIZED/' + '20170704T103019_20170704T103637_T32TLR');
           
       
  //Importing the SIAC atmospheric correction module
var siac = require('users/marcyinfeng/utils:SIAC');            
var imageBOA = siac.get_sur(imageTOA);
var imageBoaSelect= imageBOA.select("B8" , "B12", "B4", "B3", "B2");
var image_prefire= imageBoaSelect.clip(geometry);

var image_postfire = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20180619T103019_20180619T103559_T32TLR') //Pre_Fire image
                         .select(['B4','B8']); 
                         
var image_2022 = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20220618T102559_20220618T103528_T32TLR') //Present image
                         .select(['B4','B8']); 

//---------- Expression using image band indices to calculate NBR-----------------------
var bandIndexExp = '(b("B8") - b("B4")) / (b("B8") + b("B4"))';
var NDVI_prefire = image_prefire.expression(bandIndexExp).rename('NDVI');
var NDVI_postfire = image_postfire.expression(bandIndexExp).rename('NDVI');
var NDVI_2022 = image_2022.expression(bandIndexExp).rename('NDVI');

//---Histogram-------------
var histo_NDVI_prefire = ui.Chart.image.histogram({
  image: NDVI_prefire,
  region: geometry,
  scale: 50,
  maxBuckets: 50,
  minBucketWidth: 0.01,
})
  .setOptions({
    title: 'NDVI Histogram_Prefire',
    hAxis: { title: 'NDVI' },
    vAxis: { title: 'Pixel Count' , viewWindow: {'min': 0, 'max': 250000}}
});

var histo_NDVI_postfire = ui.Chart.image.histogram({
  image: NDVI_postfire,
  region: geometry,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
})
