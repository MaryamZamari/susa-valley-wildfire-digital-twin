                         .select(['B4','B8']); 

//---------- Expression using image band indices to calculate NBR-----------------------
var bandIndexExp = '(b("B8") - b("B4")) / (b("B8") + b("B4"))';
var NDVI_prefire = image_prefire.expression(bandIndexExp).rename('NDVI');
var NDVI_postfire = image_postfire.expression(bandIndexExp).rename('NDVI');
var NDVI_2022 = image_2022.expression(bandIndexExp).rename('NDVI');

//---Histogram-------------
var histo_NDVI_prefire = ui.Chart.image.histogram({
  image: NDVI_prefire,
  region: geometry2,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
})
  .setOptions({
    title: 'NDVI Histogram_Prefire',
    hAxis: { title: 'NDVI' },
    vAxis: { title: 'Pixel Count' }
});

