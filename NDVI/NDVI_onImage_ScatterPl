/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var geometry = 
    /* color: #ffffff */
    /* shown: false */
    ee.Geometry.Polygon(
        [[[7.003083958928165, 45.21869339705463],
          [7.003083958928165, 45.110246992050875],
          [7.219377293889102, 45.110246992050875],
          [7.219377293889102, 45.21869339705463]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/
// Load the three images
var image_prefire = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20170619T103021_20170619T103806_T32TLR') //Pre_Fire image
                        // .mosaic().clip(geometry) 
                         .select(['B4','B8']); 

var image_postfire = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20180619T103019_20180619T103559_T32TLR') //Postfire_Fire image
                        // .mosaic().clip(geometry) 
                         .select(['B4','B8']); 
                         
var image_2022 = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20220618T102559_20220618T103528_T32TLR') //present image
                        // .mosaic().clip(geometry) 
                         .select(['B4','B8']); 

// Get the acquisition time of each image
var acquisitionTime_prefire = ee.Date(image_prefire.get("system:time_start"));
var acquisitionTime_postfire = ee.Date(image_postfire.get("system:time_start"));
var acquisitionTime_2022 = ee.Date(image_2022.get("system:time_start"));

// Set the "system:time_start" property for each image
image_prefire = image_prefire.set("system:time_start", acquisitionTime_prefire.millis());
image_postfire= image_postfire.set("system:time_start", acquisitionTime_postfire.millis());
image_2022= image_2022.set("system:time_start", acquisitionTime_2022.millis());

// Compute the NDVI for each image
var ndvi_prefire = image_prefire.normalizedDifference(['B8', 'B4']).rename('NDVI');
var ndvi_postfire = image_postfire.normalizedDifference(['B8', 'B4']).rename('NDVI');
var ndvi_2022 = image_2022.normalizedDifference(['B8', 'B4']).rename('NDVI');


// Create a time series chart of the NDVI values
var chart = ui.Chart.image.series({
  imageCollection: ee.ImageCollection.fromImages([ndvi_prefire, ndvi_postfire, ndvi_2022]),
  region: geometry,
  reducer: ee.Reducer.mean(),
  scale: 30
}).setOptions({
  title: 'NDVI over Time',
  hAxis: {title: 'Date'},
  vAxis: {title: 'NDVI'}
});

// Add the chart to the UI
ui.root.widgets().add(chart);
