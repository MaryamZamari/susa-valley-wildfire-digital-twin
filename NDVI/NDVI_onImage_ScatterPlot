//level C1: TOA
// Define the start and end dates for the time period covered by the collection
var startDate = ee.Date('2017-06-20');
var endDate = ee.Date('2017-07-10');

var sentinel2 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED')
                  .filterDate(startDate, endDate)
                  //.filterBounds(geometry)
                  // Pre-filter to get less cloudy granules.
                  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
                   .select(['B4','B3','B2','B8','B12'])
                   .set('system:time_start', ee.Date('2022-06-18').millis());
   //median image              
var image_prefire = sentinel2.reduce(ee.Reducer.median());

// Set the system:time_start property to the start date of the time period covered by the collection
var startTime = startDate.millis();
var medianWithTime = image_prefire.set('system:time_start', startTime);

// Print the median image with the defined start time
print('Median with start time:', medianWithTime);

// Calculate the median image
var image_prefire = sentinel2.reduce(ee.Reducer.median());

// Get the coordinates from one of the images
var referenceImage = ee.Image('COPERNICUS/S2_HARMONIZED/' + '20170704T103019_20170704T103637_T32TLR');//sentinel2.first(); // Choose a reference image from the collection
var coordinates = referenceImage.geometry();

// Set the coordinates of the median image
var image_prefire_withCoordinates = image_prefire.set('coordinates', coordinates);

// Calculate NDVI on the median image with updated coordinates
var ndvi_prefire = image_prefire_withCoordinates.normalizedDifference(['B8_median', 'B4_median']).rename('NDVI');


//---------------------------------------------------------


var image_postfire = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20180619T103019_20180619T103559_T32TLR') //Postfire_Fire image
                         .select(['B4','B8'])
                         .set('system:time_start', ee.Date('2018-06-19').millis());  
                         
var image_2022 = ee.Image('COPERNICUS/S2_SR_HARMONIZED/' + '20220618T102559_20220618T103528_T32TLR')     //present image
                         .select(['B4','B8'])
                         .set('system:time_start', ee.Date('2022-06-18').millis());
     print('image_2022', image_2022);                    
// Function to calculate NDVI.
//var ndvi_prefire = image_prefire.normalizedDifference(['B8', 'B4']).rename('NDVI');

var ndvi_prefire = medianWithTime.normalizedDifference(['B8_median', 'B4_median']).rename('NDVI');
//var ndvi_prefire = medianWithTime.normalizedDifference(['B8', 'B4']).rename('NDVI');
var ndvi_postfire = image_postfire.normalizedDifference(['B8', 'B4']).rename('NDVI');
var ndvi_2022 = image_2022.normalizedDifference(['B8', 'B4']).rename('NDVI');

print(ndvi_prefire); 
print('ndvi_2022: ' , ndvi_2022);
// Reduce the NDVI image to a mean value for each image.
var ndvi_prefire_mean = ndvi_prefire.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: ndvi_prefire.geometry(),
  scale: 10,
  maxPixels: 1e9
}); 

var ndvi_postfire_mean = ndvi_postfire.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: ndvi_postfire.geometry(),
  scale: 10,
  maxPixels: 1e9
});
var ndvi_2022_mean = ndvi_2022.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: ndvi_2022.geometry(),
  scale: 10,
  maxPixels: 1e9
});

var features = ee.FeatureCollection([
  ee.Feature(null, {'system:time_start': medianWithTime.get('system:time_start'), 'ndvi': ndvi_prefire_mean.get('NDVI')}),
  ee.Feature(null, {'system:time_start': image_postfire.get('system:time_start'), 'ndvi': ndvi_postfire_mean.get('NDVI')}),
  ee.Feature(null, {'system:time_start': image_2022.get('system:time_start'), 'ndvi': ndvi_2022_mean.get('NDVI')})
]);


print(features);

// Create a chart and set the x-axis to 'system:time_start' property and y-axis to NDVI.
var chart = ui.Chart.feature.byFeature(features, 'system:time_start')
    .setChartType('ScatterChart')
    .setOptions({
      title: 'NDVI Time Series',
      vAxis: {title: 'NDVI'},
      hAxis: {title: 'Date', format: 'MMM-yyyy'},
      pointSize: 15,
      series: {
        0: {pointShape: 'circle'},
      }
    });

// Add the chart to the UI
ui.root.widgets().add(chart);
Map.centerObject(geometry);
