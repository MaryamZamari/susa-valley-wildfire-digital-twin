// =========================================================================
// 1. GEOMETRY & BOUNDARIES
// =========================================================================
var affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");
var roi = affectedAreaCEMS.geometry();

var geoCEMS = ee.Geometry.Polygon(
  [[[7.029021402162807, 45.21972611576043],
    [7.029021402162807, 45.1146736921262],
    [7.2092658479635885, 45.1146736921262],
    [7.2092658479635885, 45.21972611576043]]], null, false);

// Outer boundary geometry difference if needed
var resultGeometry = geoCEMS ? geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3)) : roi;

// =========================================================================
// 2. IMAGERY SELECTION & ATMOSPHERIC CORRECTION
// =========================================================================
var siac = require('users/marcyinfeng/utils:SIAC');

// Pre-fire 2017 (SIAC BOA Correction)
var img_pre_TOA = ee.Image('COPERNICUS/S2_HARMONIZED/20170704T103019_20170704T103637_T32TLR');
var img_pre_BOA = siac.get_sur(img_pre_TOA);

// Post-fire 2018 & Present 2022 (Surface Reflectance)
var img_post_SR = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20180619T103019_20180619T103559_T32TLR');
var img_2022_SR = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20220618T102559_20220618T103528_T32TLR');

// =========================================================================
// 3. CONTINUOUS NDVI CALCULATION
// =========================================================================
var bandIndexExp = '(b("B8") - b("B4")) / (b("B8") + b("B4"))';

var ndvi_pre = img_pre_BOA.expression(bandIndexExp).rename('NDVI').clip(roi);
var ndvi_post = img_post_SR.expression(bandIndexExp).rename('NDVI').clip(roi);
var ndvi_2022 = img_2022_SR.expression(bandIndexExp).rename('NDVI').clip(roi);

// =========================================================================
// 4. CLASSIFIED NDVI (YOUR 12-CLASS SCHEME)
// =========================================================================
var classifyNDVI = function(ndviImg) {
  return ndviImg.expression(
    "(b('NDVI') < -0.2) ? 0" +
    ": (b('NDVI') <= 0.0) ? 1" +
    ": (b('NDVI') <= 0.1) ? 2" +
    ": (b('NDVI') <= 0.2) ? 3" +
    ": (b('NDVI') <= 0.3) ? 4" +
    ": (b('NDVI') <= 0.4) ? 5" +
    ": (b('NDVI') <= 0.5) ? 6" +
    ": (b('NDVI') <= 0.6) ? 7" +
    ": (b('NDVI') <= 0.7) ? 8" +
    ": (b('NDVI') <= 0.8) ? 9" +
    ": (b('NDVI') <= 0.9) ? 10" +
    ": (b('NDVI') <= 1.0) ? 11" +
    ": 12", {}
  ).rename('NDVI_Class');
};

var ndvi_2022_classified = classifyNDVI(ndvi_2022);

// =========================================================================
// 5. VISUALIZATION & MAP LAYERS
// =========================================================================
var ndviVisContinuous = {
  min: -0.2, 
  max: 1.0, 
  palette: ['#000000','#a50026','#d73027','#f46d43','#fdae61','#fee08b','#ffffbf','#d9ef8b','#a6d96a','#66bd63','#1a9850','#006837']
};

var ndviVisClassified = {
  min: 0, 
  max: 11, 
  palette: ['#000000','#a50026','#d73027','#f46d43','#fdae61','#fee08b','#ffffbf','#d9ef8b','#a6d96a','#66bd63','#1a9850','#006837']
};

Map.centerObject(affectedAreaCEMS, 12);

// All temporal layers set to true so they display in the Layers menu:
Map.addLayer(ndvi_pre, ndviVisContinuous, 'NDVI Continuous Pre-Fire (2017)', true);
Map.addLayer(ndvi_post, ndviVisContinuous, 'NDVI Continuous Post-Fire (2018)', true);
Map.addLayer(ndvi_2022, ndviVisContinuous, 'NDVI Continuous Present (2022)', true);

// Classified versions (toggleable in Map Layers)
Map.addLayer(classifyNDVI(ndvi_pre), ndviVisClassified, 'NDVI Classified Pre-Fire (2017)', false);
Map.addLayer(classifyNDVI(ndvi_post), ndviVisClassified, 'NDVI Classified Post-Fire (2018)', false);
Map.addLayer(ndvi_2022_classified, ndviVisClassified, 'NDVI Classified Present (2022)', false);

// Vector Boundary Overlay
var outline = ee.Image().byte().paint({featureCollection: affectedAreaCEMS, color: 1, width: 2});
Map.addLayer(outline, {palette: 'FF0000'}, 'CEMS Burned Boundary');
// =========================================================================
// 6. HISTOGRAMS & TIME SERIES (OPTIMIZED TO AVOID MEMORY LIMITS)
// =========================================================================
// Pre-fire Histogram
var histo_pre = ui.Chart.image.histogram({
  image: ndvi_pre,
  region: roi,
  scale: 30, // Increased to 30m scale to eliminate memory overflow
  maxBuckets: 40
}).setOptions({
  title: 'NDVI Histogram - PreFire (2017)',
  hAxis: {title: 'NDVI'},
  vAxis: {title: 'Pixel Count'}
});

// Post-fire Histogram
var histo_post = ui.Chart.image.histogram({
  image: ndvi_post,
  region: roi,
  scale: 30,
  maxBuckets: 40
}).setOptions({
  title: 'NDVI Histogram - PostFire (2018)',
  hAxis: {title: 'NDVI'},
  vAxis: {title: 'Pixel Count'}
});

// 2022 Histogram
var histo_2022 = ui.Chart.image.histogram({
  image: ndvi_2022,
  region: roi,
  scale: 30,
  maxBuckets: 40
}).setOptions({
  title: 'NDVI Histogram - Present (2022)',
  hAxis: {title: 'NDVI'},
  vAxis: {title: 'Pixel Count'}
});

print(histo_pre);
print(histo_post);
print(histo_2022);

// Time Series Scatter Plot
var ndviCol = ee.ImageCollection([
  ndvi_pre.set('system:time_start', ee.Date('2017-07-04').millis()),
  ndvi_post.set('system:time_start', ee.Date('2018-06-19').millis()),
  ndvi_2022.set('system:time_start', ee.Date('2022-06-18').millis())
]);

var timeSeriesChart = ui.Chart.image.series({
  imageCollection: ndviCol,
  region: roi,
  reducer: ee.Reducer.mean(),
  scale: 30,
  xProperty: 'system:time_start'
}).setOptions({
  title: 'NDVI Mean Recovery Time Series',
  hAxis: {title: 'Date'},
  vAxis: {title: 'Mean NDVI'},
  pointSize: 5
});

print(timeSeriesChart);

// =========================================================================
// 7. CUSTOM LEGEND PANEL
// =========================================================================
var legendPanel = ui.Panel({
  style: {position: 'bottom-left', padding: '6px 8px'}
});

legendPanel.add(ui.Label({
  value: 'NDVI Classification',
  style: {fontSize: '14px', fontWeight: 'bold', margin: '0 0 6px 0'}
}));

var colors = ['#000000','#a50026','#d73027','#f46d43','#fdae61','#fee08b','#ffffbf','#d9ef8b','#a6d96a','#66bd63','#1a9850','#006837'];
var labels = [
  'Little/no vegetation cover (< -0.2)',
  'Sparse vegetation / grassland (-0.2 - 0.0)',
  'Sparse / degraded land (0.0 - 0.1)',
  'Moderate vegetation cover (0.1 - 0.2)',
  'Moderate-high vegetation (0.2 - 0.3)',
  'High vegetation cover (0.3 - 0.4)',
  'Very high vegetation cover (0.4 - 0.5)',
  'Very dense vegetation (0.5 - 0.6)',
  'Extremely high vegetation (0.6 - 0.7)',
  'Extremely dense vegetation (0.7 - 0.8)',
  'Near-optimal productivity (0.8 - 0.9)',
  'Optimal productivity (> 0.9)'
];

for (var i = 0; i < 12; i++) {
  var colorBox = ui.Label({
    style: {backgroundColor: colors[i], padding: '8px', margin: '0 6px 4px 0'}
  });
  var labelText = ui.Label({
    value: labels[i],
    style: {margin: '2px 0 0 0', fontSize: '11px'}
  });
  legendPanel.add(ui.Panel({
    widgets: [colorBox, labelText],
    layout: ui.Panel.Layout.Flow('horizontal')
  }));
}

Map.add(legendPanel);

// =========================================================================
// 8. EXPORT TASK
// =========================================================================
Export.image.toDrive({
  image: ndvi_2022,
  description: 'S2_NDVI_2022_SusaValley',
  scale: 10,
  region: roi,
  maxPixels: 1e13
});