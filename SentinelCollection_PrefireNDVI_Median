// Map the function over a month of data and take the median.
// Load Sentinel-2 TOA reflectance data (adjusted for processing changes
// that occurred after 2022-01-25).
var sentinel2 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED')
                  .filterDate('2017-06-20', '2017-07-10')
                  .filterBounds(roi)
                  // Pre-filter to get less cloudy granules.
                  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
                   .select(['B4','B3','B2','B8','B12']);
                 
var s2_median = sentinel2.reduce(ee.Reducer.median());
