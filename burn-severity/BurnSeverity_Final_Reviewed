// =========================================================================
// 1. IMPORTS & GEOMETRY DEFINITION
// =========================================================================
var affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");
var geoCEMS = ee.Geometry.Polygon(
  [[[7.029021402162807, 45.21972611576043],
    [7.029021402162807, 45.1146736921262],
    [7.2092658479635885, 45.1146736921262],
    [7.2092658479635885, 45.21972611576043]]], null, false);

var resultGeometry = geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3));

// =========================================================================
// 2. IMAGE PREPROCESSING & NBR / dNBR CALCULATIONS
// =========================================================================
var waterMask = ee.Image('JRC/GSW1_2/GlobalSurfaceWater').select('max_extent').not();

var prefire_image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20170619T103021_20170619T103806_T32TLR')
  .select(['B8', 'B12'])
  .updateMask(waterMask);

var postfire_image = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20171116T103311_20171116T103542_T32TLR')
  .select(['B8', 'B12'])
  .updateMask(waterMask);

var bandIndexExp = '(b("B8") - b("B12")) / (b("B8") + b("B12"))';
var prefire_nbr = prefire_image.expression(bandIndexExp).rename('NBR_Prefire');
var postfire_nbr = postfire_image.expression(bandIndexExp).rename('NBR_Postfire');

var delta_nbr = prefire_nbr.subtract(postfire_nbr).rename('dNBR');

// =========================================================================
// 3. THRESHOLDS & BURN SEVERITY CLASSIFICATION
// =========================================================================
var threshold_enhanced_regrowth_high = -0.3;  
var threshold_enhanced_regrowth_low = -0.1; 
var threshold_unburned = 0.3;
var threshold_low_severity = 0.4;
var threshold_moderate_low_severity = 0.5;
var threshold_moderate_high_severity = 0.7;
var threshold_high_severity = 1;

var burnSeverity = delta_nbr.expression(
  "(b('dNBR') <= threshold_enhanced_regrowth_high) ? 0" + 
  ": (b('dNBR') <= threshold_enhanced_regrowth_low) ? 1" + 
  ": (b('dNBR') <= threshold_unburned) ? 2" + 
  ": (b('dNBR') <= threshold_low_severity) ? 3" + 
  ": (b('dNBR') <= threshold_moderate_low_severity) ? 4" + 
  ": (b('dNBR') <= threshold_moderate_high_severity) ? 5" + 
  ": (b('dNBR') <= threshold_high_severity) ? 6" +
  ": 7", 
  {
    threshold_enhanced_regrowth_high: threshold_enhanced_regrowth_high,  
    threshold_enhanced_regrowth_low: threshold_enhanced_regrowth_low, 
    threshold_unburned: threshold_unburned,
    threshold_low_severity: threshold_low_severity,
    threshold_moderate_low_severity: threshold_moderate_low_severity,
    threshold_moderate_high_severity: threshold_moderate_high_severity,
    threshold_high_severity: threshold_high_severity  
  }
).rename('burnSeverity');

// =========================================================================
// 4. HISTOGRAMS & CATEGORICAL CHARTS
// =========================================================================
// A. Continuous dNBR Histogram
var histogram_burnSeverity = ui.Chart.image.histogram({
  image: delta_nbr,
  region: affectedAreaCEMS,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
}).setOptions({
  title: 'Burn Severity Continuous Histogram (dNBR)',
  hAxis: { title: 'dNBR Value' },
  vAxis: { title: 'Pixel Count' }
}); 

// B. Raw Categorical Histogram (Numerical Class IDs 0-7)
var histogram_burnSeverity_thresh = ui.Chart.image.histogram({
  image: burnSeverity,
  region: affectedAreaCEMS,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
}).setOptions({
  title: 'Burn Severity Categorical Histogram',
  hAxis: { title: 'Class ID (0-7)' },
  vAxis: { title: 'Pixel Count' }
}); 

print(histogram_burnSeverity);
print(histogram_burnSeverity_thresh);

// C. Labeled Categorical Chart (With Text Class Names)
var classCounts = ee.Image.pixelArea().gt(0)
  .addBands(burnSeverity)
  .reduceRegion({
    reducer: ee.Reducer.count().group({
      groupField: 1,
      groupName: 'class_id',
    }),
    geometry: affectedAreaCEMS,
    scale: 10,
    maxPixels: 1e13
  });

var countList = ee.List(classCounts.get('groups'));

var classNames = ee.List([
  '0: Enhanced regrowth_high',
  '1: Enhanced regrowth_low',
  '2: Unburned',
  '3: Low burn Severity',
  '4: Moderate_low Severity',
  '5: Moderate_high Severity',
  '6: High Severity',
  '7: No value'
]);

var chartData = countList.map(function(item) {
  var dict = ee.Dictionary(item);
  var id = ee.Number(dict.get('class_id'));
  var count = dict.get('count');
  var name = classNames.get(id);
  return ee.Feature(null, {'Class': name, 'Pixel Count': count});
});

var featureCollection = ee.FeatureCollection(chartData);

var categoricalChart = ui.Chart.feature.byFeature({
  features: featureCollection,
  xProperty: 'Class',
  yProperties: ['Pixel Count']
}).setChartType('ColumnChart').setOptions({
  title: 'Burn Severity Pixel Count by Class Name',
  hAxis: { title: 'Severity Class', slantedText: true, slantedTextAngle: 30 },
  vAxis: { title: 'Pixel Count' },
  colors: ['#3182bd'],
  legend: { position: 'none' }
});

print(categoricalChart);

// =========================================================================
// 5. MAP VISUALIZATION & LEGEND
// =========================================================================
Map.centerObject(affectedAreaCEMS, 12);

// Corrected Hex Codes (added '#' to '#a600d4')
var color = ['#778835', '#a7c050', '#0be344', '#f8fc11', '#f8b140', '#f8671a', '#a600d4', '#808080'];

var lc_class = [
  'Enhanced regrowth_high',
  'Enhanced regrowth_low',
  'Unburned',
  'Low burn Severity',
  'Moderate_low Severity',
  'Moderate_high Severity',
  'High Severity',
  'No value'
];

var visBurnSeverity = {min: 0, max: 7, palette: color};

Map.addLayer(burnSeverity, visBurnSeverity, 'Burn Severity');
Map.addLayer(resultGeometry, {color: 'black'}, 'Outer Boundary');

// Dynamic Legend Panel
var panel = ui.Panel({
  style: { position: 'bottom-left', padding: '8px' }
});

panel.add(ui.Label({
  value: 'Classification',
  style: { fontSize: '14px', fontWeight: 'bold', margin: '0 0 6px 0' }
}));

var list_legend = function(colorHex, description) {
  var c = ui.Label({
    style: { backgroundColor: colorHex, padding: '8px', margin: '0 6px 4px 0' }
  });
  var ds = ui.Label({
    value: description,
    style: { margin: '2px 0 0 0', fontSize: '12px' }
  });
  return ui.Panel({
    widgets: [c, ds],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
};

for (var a = 0; a <= 7; a++) {
  panel.add(list_legend(color[a], lc_class[a]));
}

Map.add(panel);

// =========================================================================
// 6. EXPORT TASK
// =========================================================================
Export.image.toDrive({
  image: burnSeverity,
  description: 'S2_2017_BurnSeverity_SusaValley',
  scale: 10,
  region: geoCEMS,
  maxPixels: 1e9
});