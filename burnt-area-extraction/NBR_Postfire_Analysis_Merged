// =========================================================================
// 1. IMPORTS & GEOMETRY DEFINITION
// =========================================================================
var affectedAreaCEMS = ee.FeatureCollection("users/ZamariMaryam/EMSR253_02SUSA_DEL_v2_observed_event_a");
var geoCEMS = ee.Geometry.Polygon(
  [[[7.029021402162807, 45.21972611576043],
    [7.029021402162807, 45.1146736921262],
    [7.2092658479635885, 45.1146736921262],
    [7.2092658479635885, 45.21972611576043]]], null, false);

var resultGeometry = geoCEMS.difference(affectedAreaCEMS, ee.ErrorMargin(1e-3));

// =========================================================================
// 2. IMAGE PREPROCESSING & POST-FIRE NBR COMPUTATION
// =========================================================================
var waterMask = ee.Image('JRC/GSW1_2/GlobalSurfaceWater').select('max_extent').not();

var postFireImage = ee.Image('COPERNICUS/S2_SR_HARMONIZED/20171116T103311_20171116T103542_T32TLR')
  .select(['B12', 'B8'])
  .updateMask(waterMask);

// B12 first: (B12 - B8) / (B12 + B8) to match original index orientation
var nbrPostFire = postFireImage.normalizedDifference(['B12', 'B8']).rename('NBR');

// =========================================================================
// 3. 3-CLASS SIMPLE CLASSIFICATION
// =========================================================================
// 0 = Burned, 1 = Not burned, 2 = Healthy vegetation
var nbrSimpleClassified = nbrPostFire.expression(
  "(b('NBR') > 0.1) ? 0" +        // Burned
  ": (b('NBR') >= -0.2) ? 1" +    // Not burned / Bare soil
  ": 2",                          // Healthy vegetation
  { NBR: nbrPostFire }
).rename('NBR_Simple_Class');

// =========================================================================
// 4. STATISTICAL AREA CALCULATIONS
// =========================================================================
var threshBurned = 0.1;
var burnedMask = nbrPostFire.gt(threshBurned); // Values > 0.1 indicate burned area

var areaImage = ee.Image.pixelArea().rename('totalArea')
  .addBands(ee.Image.pixelArea().updateMask(burnedMask).rename('burnedArea'));

var areaStats = areaImage.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: geoCEMS,
  scale: 10,
  crs: 'EPSG:32632',
  maxPixels: 1e13
});

var burnedAreaHa = ee.Number(areaStats.get('burnedArea')).divide(10000);
var totalAreaHa = ee.Number(areaStats.get('totalArea')).divide(10000);
var burnedPercentage = burnedAreaHa.divide(totalAreaHa).multiply(100);

print('=== POST-FIRE METRICS ===');
print('Burned Area (Hectares):', burnedAreaHa);
print('Total Area (Hectares):', totalAreaHa);
print('Burned Fraction (%):', burnedPercentage);

// =========================================================================
// 5. HISTOGRAM CHARTS
// =========================================================================
// Overall Post-Fire NBR Histogram
var histogramNBR = ui.Chart.image.histogram({
  image: nbrPostFire,
  region: affectedAreaCEMS,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
}).setOptions({
  title: 'Post-Fire NBR Distribution (Full Event)',
  hAxis: { title: 'NBR' },
  vAxis: { title: 'Pixel Count' },
  colors: ['#3182bd']
});

// Burned Pixels Subset Histogram (> 0.1 NBR)
var histogramBurned = ui.Chart.image.histogram({
  image: nbrPostFire.updateMask(burnedMask),
  region: affectedAreaCEMS,
  scale: 10,
  maxBuckets: 50,
  minBucketWidth: 0.01,
}).setOptions({
  title: 'Burned Areas Distribution (NBR > 0.1)',
  hAxis: { title: 'NBR Value' },
  vAxis: { title: 'Pixel Count' },
  colors: ['#de2d26']
});

print(histogramNBR);
print(histogramBurned);

// =========================================================================
// 6. MAP VISUALIZATION & LEGEND
// =========================================================================
Map.centerObject(affectedAreaCEMS, 12);

// Add Continuous NBR Layer
Map.addLayer(
  nbrPostFire, 
  {min: -0.8, max: 0.8, palette: ['green', 'yellow', 'orange', 'red']}, 
  'Post-Fire NBR (Continuous)',
  false
);

// Add 3-Class Layer
Map.addLayer(
  nbrSimpleClassified, 
  {min: 0, max: 2, palette: ['#FF0000', '#FFA500', '#008000']}, 
  'Classification (3 Classes)'
);

Map.addLayer(affectedAreaCEMS, {color: 'black'}, 'CEMS Event Boundary');

// 3-Class Legend Builder
var legendPanel = ui.Panel({
  style: { position: 'bottom-left', padding: '8px' }
});

legendPanel.add(ui.Label({
  value: 'Classification',
  style: { fontSize: '14px', fontWeight: 'bold', margin: '0 0 6px 0' }
}));

var classes = ['Burned', 'Not burned', 'Healthy vegetation'];
var colors = ['#FF0000', '#FFA500', '#008000'];

for (var i = 0; i < classes.length; i++) {
  var colorBox = ui.Label({
    style: { backgroundColor: colors[i], padding: '8px', margin: '0 6px 4px 0' }
  });
  var description = ui.Label({
    value: classes[i],
    style: { margin: '2px 0 0 0', fontSize: '12px' }
  });
  legendPanel.add(ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  }));
}

Map.add(legendPanel);

// =========================================================================
// 7. EXPORT TASK
// =========================================================================
Export.image.toDrive({
  image: nbrPostFire,
  description: 'S2_20171116_NBR_Postfire',
  scale: 10,
  region: geoCEMS,
  maxPixels: 1e9
});