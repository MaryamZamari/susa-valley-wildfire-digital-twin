                  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',20))
             //     .filter(ee.Filter.lt('SNOW_ICE_PERCENTAGE',5))     // ---> I comment it because it gave me less pixels. and the wrong results were the same
                  .filterBounds(roi)
                //  .map(maskS2clouds)//This mask eliminates a lot of pixels...
                  
                  .map(function(image) {
                     return image.divide(10000);    //dividing so that the reflectance values will be between 0 and 1
                  }) ;

//---------------------Index Calculation phase ----------------------------------------------
 
// Function to calculate NBR index
function calculateNBR(image) {
  // Select NIR and SWIR bands from the image
  var nir = image.select('B8');
  var swir = image.select('B12');
  
  // Calculate NBR index
  var nbr = nir.subtract(swir).divide(nir.add(swir)).rename('NBR');
  
  return nbr;
}

  
// here i map the function over the collection to get the NBR for each image
var nbr_collection = dataset.map(calculateNBR);  
            
            
//---------------------Visualisation phase ----------------------------------------------

