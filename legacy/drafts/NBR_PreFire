// Function to calculate NBR index
function calculateNBR(image) {
  // Select NIR and SWIR bands from the image
  var nir = image.select('B8');
  var swir = image.select('B12');
  
  // Calculate NBR index
  var nbr = nir.subtract(swir).divide(nir.add(swir)).rename('NBR');
  
  return nbr;
}
  
// here i mapped the function over the collection to get the NBR for each image
var nbr_collection = sentinel2.map(calculateNBR);  
            
// Clip  NBR 
