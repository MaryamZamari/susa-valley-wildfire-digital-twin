var roi = /* color: #eaeaea */ee.Geometry.Polygon(
        [[[6.6235811871412364, 45.20882936495508],
          [6.6235811871412364, 44.91394352253096],
          [7.500427500617799, 44.91394352253096],
          [7.500427500617799, 45.20882936495508]]], null, false),
    dem = ee.Image("USGS/SRTMGL1_003");
