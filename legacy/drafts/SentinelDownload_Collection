// Define the list of dates              
var startDate = ee.Date('2017-11-10');
var endDate = ee.Date('2018-03-31');
//var dateList = ee.List.sequence(startDate.get('millis'), endDate.get('millis'), null, 31);

var interval = 31 * 24 * 60 * 60 * 1000; // 31 days in milliseconds
var dateList = ee.List.sequence(startDate.millis(), endDate.millis(), interval);

// Define the Sentinel-2 Level 2A image collection
var sentinel2 = ee.ImageCollection('COPERNICUS/S2_SR')
                  .filterBounds(roi)
                  .filterMetadata('MGRS_TILE', 'equals', '32TMT')
                  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20));
                  
                  
// Define the function to download an image
var downloadImage = function(image) {
  var imageName = ee.String(image.id()).getInfo();
  Export.image.toDrive({
    image: image.clip(roi),
    description: imageName,
    folder: 'Sentinel2_2021',
    scale: 10,
    region: roi
  });
};

// Loop over the list of dates and download the images
dateList.getInfo().forEach(function(date) {
  var formattedDate = ee.Date(date).format('YYYY-MM-dd').getInfo();
  var nextDate = ee.Date(date).advance(1, 'month');
  var image = sentinel2.filterDate(formattedDate, nextDate).first();
  if (image) {
    downloadImage(image);
  } else {
    print('No image available for ' + formattedDate);
  }
});
